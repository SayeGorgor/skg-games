# Core
DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protects /api/cron/publish-daily in production.
CRON_SECRET=replace-me

# Neon Managed Better Auth. Leave BOTH blank for anonymous-only local demo mode.
# Copy the branch Auth URL from Neon Console (includes /dbname/auth).
NEON_AUTH_BASE_URL=
# At least 32 characters; generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Stripe (optional until SKG Plus is enabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_MONTHLY_PRICE_ID=
STRIPE_PLUS_YEARLY_PRICE_ID=

# Analytics / monitoring (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=

# Advertising and Plus promotions: only true enables them (default: disabled).
# Restart development or rebuild production after changes.
NEXT_PUBLIC_ADS_ENABLED=

# Operator terminal only: bootstrap CLI reads this PROCESS variable explicitly.
# It never loads .env.local or falls back to DATABASE_URL. Do not set for app deployment.
SKG_RBAC_BOOTSTRAP_DATABASE_URL=
